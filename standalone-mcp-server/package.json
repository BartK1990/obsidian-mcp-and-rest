{
  "name": "obsidian-mcp-standalone-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, Dockerizable MCP server that syncs an Obsidian vault with a git repository and exposes it over MCP (Streamable HTTP).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "simple-git": "^3.27.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
