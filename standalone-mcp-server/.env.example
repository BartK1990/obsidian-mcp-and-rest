# Copy to .env and fill in before running docker compose.
# You can also leave REPO_URL/GIT_TOKEN unset and configure the git
# connection later through the web UI at http://<host>:8123/.

REPO_URL=https://github.com/yourname/your-vault.git
REPO_BRANCH=main

# GitHub fine-grained/classic Personal Access Token with contents:read+write
# on the vault repo. Username can stay as x-access-token for GitHub PATs.
GIT_USERNAME=x-access-token
GIT_TOKEN=ghp_your_token_here

GIT_AUTHOR_NAME=Obsidian MCP Server
GIT_AUTHOR_EMAIL=obsidian-mcp-server@localhost

# Required in practice: this server binds to 0.0.0.0 so it's reachable
# through Docker/Portainer, unlike the local-only Obsidian plugin. It also
# guards the web UI, which can view/change the git connection.
MCP_BEARER_TOKEN=change-me-to-a-long-random-value
